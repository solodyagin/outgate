{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outgate.example/spec/credentials/credential-provider.schema.json",
  "title": "Outgate atomic credential snapshot manifest",
  "description": "Переносимое описание файлового источника атомарной пары. Реализуемый callback возвращает Go CredentialSnapshot; совместимость формата transport от этого манифеста не зависит.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "generation": {
      "$ref": "deployment-grant.schema.json#/$defs/generation"
    },
    "certificate_file": {
      "$ref": "#/$defs/protectedFile"
    },
    "private_key_file": {
      "$ref": "#/$defs/protectedFile"
    },
    "deployment_grant_file": {
      "$ref": "#/$defs/protectedFile"
    }
  },
  "required": [
    "generation",
    "certificate_file",
    "private_key_file",
    "deployment_grant_file"
  ],
  "$defs": {
    "protectedFile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$(?![\\s\\S])",
      "description": "Защищённая ссылка на локальный файл. Разрешение пути и ACL проверяются процессом deployment.",
      "x-outgate-secret": "reference"
    }
  }
}
